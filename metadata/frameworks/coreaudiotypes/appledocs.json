        },
        "kAudioChannelFlags_Meters": {
          "doc": "A flag that indicates that unit values are in meters.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/audiochannelflags/meters"
        },
        "kAudioChannelFlags_RectangularCoordinates": {
          "doc": "A flag that indicates the channel uses the speaker position’s cartesian coordinates.",
