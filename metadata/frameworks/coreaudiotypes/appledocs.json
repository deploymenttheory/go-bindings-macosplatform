    "MPEG4ObjectID": {
      "doc": "Constants that define the type of MPEG-4 audio data.",
      "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid",
      "members": {
        "kMPEG4Object_AAC_LC": {
          "doc": "A constant that specifies lossless coding, which provides compression with no loss of quality.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/aac_lc"
        },
        "kMPEG4Object_AAC_LTP": {
          "doc": "A constant that specifies long-term prediction, which reduces redundancy in a coded signal.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/aac_ltp"
        },
        "kMPEG4Object_AAC_Main": {
          "doc": "A constant that specifies advanced audio coding, which is the basic MPEG-4 technology.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/aac_main"
        },
        "kMPEG4Object_AAC_SBR": {
          "doc": "A constant that specifies spectral band replication, which reconstructs high-frequency content from lower frequencies and side information.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/aac_sbr"
        },
        "kMPEG4Object_AAC_SSR": {
          "doc": "A constant that specifies scalable sampling rate, which provides different sampling frequencies for different targets.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/aac_ssr"
        },
        "kMPEG4Object_AAC_Scalable": {
          "doc": "A constant that specifies scalable lossless coding.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/aac_scalable"
        },
        "kMPEG4Object_CELP": {
          "doc": "A constant that specifies code-excited linear prediction, which is a narrow-band/wide-band speech codec.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/celp"
        },
        "kMPEG4Object_HVXC": {
          "doc": "A constant that specifies harmonic vector excitation coding, which is a very-low bit-rate parametric speech codec.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/hvxc"
        },
        "kMPEG4Object_TwinVQ": {
          "doc": "A constant that specifies transform-domain weighted interleaved vector quantization.",
          "url": "https://developer.apple.com/documentation/coreaudiotypes/mpeg4objectid/twinvq"
        }
      }
    },
    "SMPTETimeFlags": {
