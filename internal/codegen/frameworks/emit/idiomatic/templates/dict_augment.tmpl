{{/*
    dict_augment.tmpl adds small helpers to the mutable-dictionary wrapper for
    building a dictionary of keyed values from Go, without dropping to lower-level
    calls. Keys are given as Go strings; values are objects.
*/}}
{{define "dict_augment"}}// Set stores value under key (an object) and returns the receiver so calls can
// be chained.
func ({{.RecvVar}} *{{.GoTypeName}}) Set(key, value obj.Object) *{{.GoTypeName}} {
objc.Send[objc.ID](objref.IDOf({{.RecvVar}}), objc.RegisterName("setObject:forKey:"), objref.IDOf(value), objref.IDOf(key))
return {{.RecvVar}}
}

// SetString stores value under the given string key and returns the receiver so
// calls can be chained.
func ({{.RecvVar}} *{{.GoTypeName}}) SetString(key string, value obj.Object) *{{.GoTypeName}} {
objc.Send[objc.ID](objref.IDOf({{.RecvVar}}), objc.RegisterName("setObject:forKey:"), objref.IDOf(value), purego.NSString(key))
return {{.RecvVar}}
}

// Get returns the value stored under the given string key, or nil when there is
// none.
func ({{.RecvVar}} *{{.GoTypeName}}) Get(key string) obj.Object {
return obj.Wrap(objc.Send[objc.ID](objref.IDOf({{.RecvVar}}), objc.RegisterName("objectForKey:"), purego.NSString(key)))
}

{{end}}
