{{/*
    plain_method.tmpl — a pass-through wrapper forwarding to the raw method.
    Eight body shapes: (HasError yes/no) × (RetMode void|raw|string|trialwrap),
    where string converts *NSString→Go string and trialwrap wraps *raw.T→*T.
*/}}
{{define "plain_method"}}// {{.GoName}} calls the underlying {{.RawGoName}}.
func {{.Recv}}{{.GoName}}({{.ParamStr}}){{.RetSig}} {
{{- if .HasError}}
{{- if or (eq .RetMode "void") (eq .RetMode "raw")}}
return {{.Call}}
{{- else if eq .RetMode "string"}}
_r, _err := {{.Call}}
if _err != nil {
return "", _err
}
if _r == nil {
return "", nil
}
return purego.GoString(_r.Ptr()), nil
{{- else if eq .RetMode "trialwrap"}}
_r, _err := {{.Call}}
if _err != nil {
return nil, _err
}
if _r == nil {
return nil, nil
}
return &{{.TrialType}}{inner: _r}, nil
{{- end}}
{{- else}}
{{- if eq .RetMode "void"}}
{{.Call}}
{{- else if eq .RetMode "raw"}}
return {{.Call}}
{{- else if eq .RetMode "string"}}
_r := {{.Call}}
if _r == nil {
return ""
}
return purego.GoString(_r.Ptr())
{{- else if eq .RetMode "trialwrap"}}
_r := {{.Call}}
if _r == nil {
return nil
}
return &{{.TrialType}}{inner: _r}
{{- end}}
{{- end}}
}

{{end}}
