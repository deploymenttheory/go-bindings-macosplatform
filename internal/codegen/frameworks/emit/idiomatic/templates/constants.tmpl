{{/*
    constants.tmpl renders accessors for a framework's global constant values.
    Each constant is a named symbol in the framework's library; _symbol returns
    its address and CFConstant reads the value from it. CoreFoundation references
    and most string constants are objects (returned as obj.Object); Foundation's
    own string constants are returned as the package's String type. CommentBlock
    carries the constant's documentation line (already "// …\n") when present.
*/}}
{{define "cf_constants"}}{{range .Items}}{{.CommentBlock}}// {{.GoName}} returns the value of the constant {{.ExternName}}.
func {{.GoName}}() obj.Object { return obj.Wrap(purego.CFConstant(_symbol({{.ExternName | printf "%q"}}))) }

{{end}}{{range .StringItems}}{{.CommentBlock}}// {{.GoName}} returns the string constant {{.ExternName}}.
func {{.GoName}}() *String { return StringFromID(purego.CFConstant(_symbol({{.ExternName | printf "%q"}}))) }

{{end}}{{range .StringIDItems}}{{.CommentBlock}}// {{.GoName}} returns the string constant {{.ExternName}}, for use as a dictionary key or argument.
func {{.GoName}}() obj.Object { return obj.Wrap(purego.CFConstant(_symbol({{.ExternName | printf "%q"}}))) }

{{end}}{{end}}
