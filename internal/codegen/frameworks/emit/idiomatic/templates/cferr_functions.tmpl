{{/*
    cferr_functions.tmpl — wrappers for C functions whose last parameter is a
    CFErrorRef out-parameter: the error param is dropped from the Go signature,
    populated internally, and surfaced as a structured Go error on failure
    (bool→error; pointer→(unsafe.Pointer, error)). The _cfErrOrMsg helper is
    emitted once per package after the wrappers.
*/}}
{{define "cferr_functions"}}{{range .Entries}}// {{.GoFnName}} calls [{{$.RawAlias}}.{{.GoFnName}}], converting the CFErrorRef out-parameter to a structured Go error on failure.
{{if .RetIsBool -}}
func {{.GoFnName}}({{.Sig}}) error {
var _cfErr unsafe.Pointer
{{if .IsPureBool -}}
if !{{.RawCall}} {
{{else -}}
_ok := {{.RawCall}}
if _ok == 0 {
{{end -}}
return _cfErrOrMsg(_cfErr, {{.RawFnName | printf "%q"}})
}
return nil
}
{{else -}}
func {{.GoFnName}}({{.Sig}}) (unsafe.Pointer, error) {
var _cfErr unsafe.Pointer
_result := {{.RawCall}}
if _result == nil {
return nil, _cfErrOrMsg(_cfErr, {{.RawFnName | printf "%q"}})
}
return _result, nil
}
{{end}}
{{end}}// _cfErrOrMsg converts a CFErrorRef to a structured Go error (domain, code,
// description, failure reason). A CFErrorRef is an NSError, so it is read
// through the NSError path with no CGo. Falls back to a plain message if no
// error was populated.
func _cfErrOrMsg(ptr unsafe.Pointer, fn string) error {
if ptr != nil {
return objcerrors.CFErrorToError(ptr)
}
return fmt.Errorf("[%s] operation failed", fn)
}
{{end}}
