{{/*
    with_setter.tmpl renders a With… method that sets one Objective-C property
    and returns the receiver, so calls can be chained. There are two shapes: a
    collection property, which takes a variable number of items and builds an
    Objective-C array from them, and a single-value property.
*/}}
{{define "with_setter"}}{{.DocComment}}{{if .IsNSArray -}}
func ({{.RecvVar}} *{{.TypeName}}) {{.GoName}}(items ...{{.SliceElemType}}) *{{.TypeName}} {
_arr := purego.SliceToNSArray(items, func(_v {{.SliceElemType}}) objc.ID { return objref.IDOf(_v) })
objc.Send[objc.ID](objref.IDOf({{.RecvVar}}), objc.RegisterName({{.SetterSelector | printf "%q"}}), _arr)
return {{.RecvVar}}
}

{{else -}}
func ({{.RecvVar}} *{{.TypeName}}) {{.GoName}}({{.ParamName}} {{.ParamType}}) *{{.TypeName}} {
objc.Send[objc.ID](objref.IDOf({{.RecvVar}}), objc.RegisterName({{.SetterSelector | printf "%q"}}), {{.ParamRawExpr}})
return {{.RecvVar}}
}

{{end}}{{end}}
