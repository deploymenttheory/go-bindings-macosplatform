{{/*
    with_setter.tmpl renders a With… method that sets one Objective-C property
    and returns the receiver, so calls can be chained. There are two shapes: a
    collection property, which takes a variable number of items and builds an
    Objective-C array from them, and a single-value property.
*/}}
{{define "with_setter"}}{{if .DocComment}}{{.DocComment}}//
{{end}}{{if .IsNSArray -}}
// {{.GoName}} sets the collection and returns the receiver so calls can be chained.
func (x *{{.TypeName}}) {{.GoName}}(items ...{{.SliceElemType}}) *{{.TypeName}} {
_arr := purego.SliceToNSArray(items, func(_v {{.SliceElemType}}) objc.ID { return objref.IDOf(_v) })
objc.Send[objc.ID](objref.IDOf(x), objc.RegisterName({{.SetterSelector | printf "%q"}}), _arr)
return x
}

{{else -}}
// {{.GoName}} sets {{.ParamName}} and returns the receiver so calls can be chained.
func (x *{{.TypeName}}) {{.GoName}}({{.ParamName}} {{.ParamType}}) *{{.TypeName}} {
objc.Send[objc.ID](objref.IDOf(x), objc.RegisterName({{.SetterSelector | printf "%q"}}), {{.ParamRawExpr}})
return x
}

{{end}}{{end}}
