{{/*
    class_header.tmpl renders a wrapper type for one Objective-C class. The
    wrapper stores only the Objective-C object pointer (inside the embedded
    objref.Handle); methods are emitted in the other templates. Two factory
    helpers exist because the two come from different ownership situations:
    <T>FromID is for an object you did not create (it adds a reference so Go can
    keep it alive), while the Adopt helper is for an object a constructor just
    created (Go already owns that reference, so it must not add another). Both
    arrange for the object to be released once Go stops using it.
    Description/IsEqual/IsKind let the wrapper be used as an obj.Object.
*/}}
{{define "class_header"}}{{if .DocComment}}{{.DocComment}}//
{{end}}// {{.GoTypeName}} is an idiomatic wrapper over the Objective-C class {{.ClassName}}.
type {{.GoTypeName}} struct {
objref.Handle
}

// {{.GoTypeName}}FromID adopts an existing Objective-C object as a {{.GoTypeName}}
// (nil for 0), retaining it and registering a release finalizer.
func {{.GoTypeName}}FromID(id objc.ID) *{{.GoTypeName}} {
if id == 0 {
return nil
}
x := &{{.GoTypeName}}{Handle: objref.Wrap(purego.Retain(id))}
objref.Track(x)
return x
}

// {{.AdoptName}} wraps an Objective-C object that this code just created as a
// {{.GoTypeName}} (nil for 0). The caller already owns the object's reference,
// so this does not add another; it only arranges for the object to be released
// once Go stops using it. Constructors use it.
func {{.AdoptName}}(id objc.ID) *{{.GoTypeName}} {
if id == 0 {
return nil
}
x := &{{.GoTypeName}}{Handle: objref.Wrap(id)}
objref.Track(x)
return x
}

// Description returns the object's -description text.
func (x *{{.GoTypeName}}) Description() string {
return rt.Description(objref.IDOf(x))
}

// IsEqual reports Objective-C equality (isEqual:) with another object.
func (x *{{.GoTypeName}}) IsEqual(other obj.Object) bool {
return rt.IsEqual(objref.IDOf(x), objref.IDOf(other))
}

// IsKind reports whether the object is an instance of the named class or a subclass.
func (x *{{.GoTypeName}}) IsKind(className string) bool {
return rt.IsKind(objref.IDOf(x), className)
}
{{end}}
