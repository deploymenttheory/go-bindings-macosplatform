{{if .Sigs}}
import (
	"runtime/debug"
	"unsafe"

	"github.com/deploymenttheory/go-bindings-macosplatform/internal/tel"
)
{{end}}
{{range .Sigs}}{{template "block_trampoline_go_sig" .}}{{end}}{{end}}


{{define "block_trampoline_go_sig"}}//export goCallBlock_{{.Name}}
func goCallBlock_{{.Name}}({{.GoParams}}){{.RetDecl}} {
	defer func() {
		if r := recover(); r != nil {
			if h := tel.OnCallbackPanic; h != nil {
				h("goCallBlock_{{.Name}}", r, debug.Stack())
			}
		}
	}()
	fn := blockLookup(uint64(key)).({{.ClosureType}})
	{{.CallBody}}
}

// MakeBlock_{{.Name}} creates an ObjC block that calls fn when invoked.
// The returned block is owned by the caller; pass it to FreeBlock after use.
func MakeBlock_{{.Name}}(fn {{.ClosureType}}) unsafe.Pointer {
	key := BlockRegister(fn)
	return unsafe.Pointer(C.goMakeBlock_{{.Name}}(C.uint64_t(key)))
}

{{end}}


