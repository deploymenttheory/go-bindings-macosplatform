{{/*
    block_trampolines.tmpl — templates for the runtime block trampoline files.

    Named templates:
      block_trampolines_go_file    complete blocks_generated.go
      block_trampoline_go_sig      one goCallBlock_* export + MakeBlock_* factory pair
      block_trampolines_h_file     complete block_trampolines_generated.h
      block_trampolines_m_file     complete block_trampolines_generated.m
*/}}


{{define "block_trampolines_go_file"}}// Code generated by go-bindings-codegen. DO NOT EDIT.

//go:build darwin

package {{.PkgName}}

