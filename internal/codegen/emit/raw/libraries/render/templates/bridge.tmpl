{{/*
    bridge.tmpl — code generation templates for the C/ObjC bridge layer.

    Named templates:
      bridge_shim          package-root _bridge_impl.m shim (includes real bridge .m)
      bridge_header_file   complete _bridge.h (C declarations for all bridged symbols)
      bridge_impl_file     complete _bridge.m (ObjC @try/@catch wrapper implementations)
      bridge_impl_method   one ObjC bridge function implementation
*/}}


{{/* ── Package-root shim ─────────────────────────────────────────────────────── */}}

{{define "bridge_shim"}}// Code generated by go-bindings-codegen. DO NOT EDIT.
#ifdef API_UNAVAILABLE
#  undef API_UNAVAILABLE
#  define API_UNAVAILABLE(...)
#endif
#ifdef API_DEPRECATED
#  undef API_DEPRECATED
#  define API_DEPRECATED(...)
#endif
#ifdef API_DEPRECATED_WITH_REPLACEMENT
#  undef API_DEPRECATED_WITH_REPLACEMENT
#  define API_DEPRECATED_WITH_REPLACEMENT(...)
#endif
#import <Foundation/Foundation.h>
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wdeprecated-declarations"
#pragma clang diagnostic ignored "-Wunguarded-availability"
#pragma clang diagnostic ignored "-Wunguarded-availability-new"
#pragma clang diagnostic ignored "-Wint-conversion"
#pragma clang diagnostic ignored "-Wincompatible-pointer-types"
#include "bridge/{{.Stem}}.m"
#pragma clang diagnostic pop
{{end}}


{{/* ── Bridge header (.h) ─────────────────────────────────────────────────────── */}}

{{define "bridge_header_file"}}// Code generated by go-bindings-codegen. DO NOT EDIT.
#pragma once
#include <stdint.h>
#include <stdbool.h>
#include <stdlib.h>
#import <objc/objc.h>

{{range .MethodDecls -}}
{{range .Entitlements}}// Requires entitlement: {{.}}
{{end -}}
// {{.BridgeID}}
{{.Decl}};
{{end}}
{{- range .AllocHelpers}}
// alloc helper for New{{.ClassName}}WithXxx constructors
id {{.FuncName}}(void);
{{end}}
{{- .CodingDecls}}
{{- range .FunctionDecls}}
{{range .Entitlements}}// Requires entitlement: {{.}}
{{end -}}
// {{.BridgeID}}
{{.Decl}};
{{end}}
{{- range .ForeignDecls}}
{{range .Entitlements}}// Requires entitlement: {{.}}
{{end -}}
// {{.BridgeID}}
{{.Decl}};
{{end}}
{{- range .ProtoDecls}}
// ID: objc-protocol {{.BridgeID}}
{{.RetType}} {{.FuncName}}({{.Params}});
{{end}}
{{- range .ExternGetters}}
// ID: objc-extern-address {{.SymbolName}}
void * {{.GetterName}}(void);
{{end}}{{end}}


{{/* ── Bridge implementation (.m) ─────────────────────────────────────────────── */}}

{{define "bridge_impl_file"}}// Code generated by go-bindings-codegen. DO NOT EDIT.
{{- if .LocalHeader}}
#include "{{.LocalHeader}}"
{{- else if .UmbrellaHeader}}
#include <{{.UmbrellaHeader}}>
{{- else if .ParentFramework}}
#import <{{.ParentFramework}}/{{.ParentFramework}}.h>
{{- else}}
#import <{{.Framework}}/{{.Framework}}.h>
{{- end}}
#include "{{.HeaderName}}"

{{range .Methods}}{{template "bridge_impl_method" .}}{{end}}
{{- range .AllocImpls}}
id {{.FuncName}}(void) { return [{{.ClassName}} alloc]; }

{{end}}
{{- .CodingImpls}}
{{- range .Functions}}{{template "bridge_impl_method" .}}{{end}}
{{- range .ExternGetters}}
// ID: objc-extern-address {{.SymbolName}}
void * {{.GetterName}}(void) { return (void *)&{{.SymbolName}}; }
{{end}}
{{- range .ForeignMethods}}{{template "bridge_impl_method" .}}{{end}}
{{- range .ProtoMethods}}{{template "bridge_impl_method" .}}{{end}}
{{- end}}


{{/* ── Single bridge function implementation ───────────────────────────────────── */}}

{{define "bridge_impl_method"}}{{range .Entitlements}}// Requires entitlement: {{.}}
{{end -}}
// {{.BridgeID}}
{{.RetType}} {{.FuncName}}({{.Params}}) {
    @autoreleasepool {
        @try {
{{- if .IsNSError}}
            NSError *_err = nil;
{{- end}}
{{- if .NeedsFormatPragma}}
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wformat-security"
{{- end}}
            {{.TryBody}}
{{- if .NeedsFormatPragma}}
#pragma clang diagnostic pop
{{- end}}
        } @catch (NSException *_ex) {
            if (outException) *outException = (__bridge void *)[_ex retain];
{{- if .CatchReturn}}
            {{.CatchReturn}}
{{- end}}
        }
    }
}

{{end}}
