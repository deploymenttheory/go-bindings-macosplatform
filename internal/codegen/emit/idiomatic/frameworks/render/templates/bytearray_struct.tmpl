{{define "bytearray_structs" -}}
{{range . -}}
{{if .Doc}}{{comment .Doc}}
{{end}}// The C layout cannot be reproduced as a plain Go value struct, so it is held as
// its exact-size bytes and read through the typed As* accessors below. It is
// pointer-only: never pass it by value.
type {{.GoName}} struct {
{{if .AlignElem}}	_    [0]{{.AlignElem}}
{{end}}	data [{{.Size}}]byte
}
{{$recv := .GoName -}}
{{range .Accessors}}
// {{.GoName}} returns the {{.Field}} field, read from the backing bytes at offset {{.Offset}}.
func (u *{{$recv}}) {{.GoName}}() {{.GoType}} {
	return *(*{{.GoType}})(unsafe.Pointer(&u.data[{{.Offset}}]))
}
{{end -}}
{{end -}}
{{end}}
