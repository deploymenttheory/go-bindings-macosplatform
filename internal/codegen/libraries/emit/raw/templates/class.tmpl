{{/*
    class.tmpl — template for the generated header section of a class file.

    Named templates:
      class_file_header   generated comment + build tag + package + CGo include + imports
*/}}


{{define "class_file_header"}}// Code generated by go-bindings-codegen. DO NOT EDIT.
// Source: Xcode SDK {{.Framework}}.framework

//go:build darwin

package {{.PkgName}}

// #include "bridge/{{.BridgeHeader}}"
import "C"

import (
{{- range .Imports}}
	{{. | printf "%q"}}
{{- end}}
)

{{end}}

{{/*
    class_struct — the ObjC class's Go struct. A root class owns the ptr field
    and a promoted one-line Ptr() accessor (gofmt preserves the one-line body);
    a non-root class embeds its superclass by value. Both emit a compile-time
    cgo.Object assertion.
*/}}
{{define "class_struct"}}{{.CommentBlock}}type {{.TypeHeader}} struct {
{{.EmbedLine}}
}

{{if .IsRoot}}func (o *{{.PtrReceiver}}) Ptr() unsafe.Pointer { return o.ptr }

{{end}}var _ cgo.Object = (*{{.AssertType}})(nil)

{{end}}

{{/*
    class_constructors — the New<Class> pointer constructor (registers a
    finalizer via cgo.Track), the <Class>WithPtr value constructor (untracked,
    for embedding in subclass struct literals), and the Cast<Class> helper.
*/}}
{{define "class_constructors"}}func New{{.Name}}(ptr unsafe.Pointer) *{{.Name}}{{.GenSuffix}} {
if ptr == nil {
return nil
}
o := {{.Chain}}
cgo.Track(o, o.Ptr)
return o
}

// {{.Name}}WithPtr wraps an existing ObjC pointer as a value type for use in
// subclass struct literals. The returned value is NOT registered with the
// Go garbage collector — the caller is responsible for memory management.
// For owned references use New{{.Name}} instead.
func {{.Name}}WithPtr(ptr unsafe.Pointer) {{.Name}}{{.GenSuffix}} {
return {{.ValueChain}}
}

// Cast{{.Name}} wraps an ObjC id pointer as *{{.Name}}{{.GenSuffix}}.
// The caller is responsible for verifying the dynamic type with
// cgo.ClassNameOf before relying on the cast.
func Cast{{.Name}}(ptr unsafe.Pointer) *{{.Name}}{{.GenSuffix}} {
return New{{.Name}}(ptr)
}

{{end}}

{{/*
    designated_inits — New<Class>With<Arg> factory functions built from
    designated initializers. Each allocates via the class alloc bridge, wraps the
    result untracked (the init method registers the sole finalizer), calls the Go
    init method, and converts its result per Kind. The one-line nil guards are
    intentional — gofmt preserves one-line bodies.
*/}}
{{define "designated_inits"}}{{range .}}// {{.CtorName}} creates a new {{.ClassName}} via its designated initializer -[{{.ClassName}} {{.Selector}}].
func {{.CtorName}}({{.ArgList}}) {{.ReturnSig}} {
_raw := unsafe.Pointer(C.{{.AllocFn}}())
_obj := {{.ClassName}}WithPtr(_raw)
{{- if eq .Kind 1}}
_idResult, _err := {{.CallExpr}}
if _idResult == nil { return nil, _err }
return New{{.ClassName}}(_idResult.Ptr()), _err
{{- else if eq .Kind 2}}
_idResult := {{.CallExpr}}
if _idResult == nil { return nil }
return New{{.ClassName}}(_idResult.Ptr())
{{- else if eq .Kind 3}}
_result, _err := {{.CallExpr}}
return New{{.ClassName}}(_result), _err
{{- else if eq .Kind 4}}
return New{{.ClassName}}({{.CallExpr}})
{{- else}}
return {{.CallExpr}}
{{- end}}
}

{{end}}{{end}}

{{/*
    class_method — one generated instance or class method: the doc/annotation
    preamble, the bridge-ID comment, the signature, and the CGo body. Instance
    methods take a pointer receiver; class methods are package-level functions.
*/}}
{{define "class_method"}}{{.PreambleComment}}{{if not .Skip}}// {{.BridgeID}}
func {{if .IsClassMethod}}{{.FuncName}}{{else}}(o *{{.Receiver}}) {{.GoName}}{{end}}({{.GoArgs}}){{.RetStr}} {
{{- template "method_body" .Body}}
}

{{end}}{{end}}

{{/*
    nsstring_overload — a "…Go" Go-string convenience overload that converts its
    Go-string arguments and forwards to the underlying generated method/function.
*/}}
{{define "nsstring_overload"}}{{.Signature}} {
{{if .HasReturn}}return {{end}}{{.CallExpr}}
}

{{end}}

{{/*
    generic_helper — the New<Class>T[T] typed constructor a generic class exposes
    for generic subclasses that need the preserved type parameter.
*/}}
{{define "generic_helper"}}func New{{.Name}}T[T cgo.Object](ptr unsafe.Pointer) *{{.Name}}[T] {
if ptr == nil {
return nil
}
o := {{.TChain}}
cgo.Track(o, o.Ptr)
return o
}

{{end}}

{{/*
    typed_with_ptr — the <Class>TypedWithPtr[T] untracked value constructor used
    by generic subclasses in other packages that need Class[T] (not
    Class[cgo.Object]).
*/}}
{{define "typed_with_ptr"}}func {{.Name}}TypedWithPtr[T cgo.Object](ptr unsafe.Pointer) {{.Name}}[T] {
return {{.TValueChain}}
}

{{end}}

{{/*
    coding_methods — the NSSecureCoding/NSCoding archive convenience helpers:
    SerializeToArchive (instance) and New<Class>FromArchive (package-level), both
    bridging through the per-class serialize/deserialize C functions.
*/}}
{{define "coding_methods"}}// SerializeToArchive encodes the receiver using NSKeyedArchiver and returns
// the resulting binary plist data. Requires NSSecureCoding conformance.
func (o *{{.Name}}) SerializeToArchive() ([]byte, error) {
defer cgo.KeepAlive(o)
var _exc unsafe.Pointer
var _nsErr unsafe.Pointer
var _ptr unsafe.Pointer
var _len C.size_t
_ptr = C.{{.SerializeFn}}(o.Ptr(), &_len, &_nsErr, &_exc)
cgo.RaiseIfException(_exc)
if _nsErr != nil {
return nil, cgo.NSErrorToError(_nsErr)
}
if _ptr == nil {
return nil, nil
}
result := C.GoBytes(_ptr, C.int(_len))
C.free(_ptr)
return result, nil
}

// New{{.Name}}FromArchive decodes a {{.Name}} from binary plist data produced by
// SerializeToArchive or NSKeyedArchiver.
func New{{.Name}}FromArchive(data []byte) (*{{.Name}}, error) {
if len(data) == 0 {
return nil, nil
}
var _exc unsafe.Pointer
var _nsErr unsafe.Pointer
_ptr := unsafe.Pointer(C.{{.DeserializeFn}}(unsafe.Pointer(&data[0]), C.size_t(len(data)), &_nsErr, &_exc))
cgo.RaiseIfException(_exc)
if _nsErr != nil {
return nil, cgo.NSErrorToError(_nsErr)
}
return New{{.Name}}(_ptr), nil
}

{{end}}

{{/*
    method_body — the body of a generated CGo instance/class method: keep-alive
    defers for the receiver and ObjC-object arguments, argument preambles, the C
    bridge call, exception/NSError unpacking, and the return conversion selected
    by RetKind. The caller emits the surrounding func signature. gofmt indents
    the result; the multiline if blocks match the original byte-for-byte.
*/}}
{{define "method_body"}}
{{- if .HasReceiver}}
defer cgo.KeepAlive(o)
{{- end}}
{{- range .KeepAlives}}
defer cgo.KeepAlive({{.}})
{{- end}}
{{- range .Preambles}}
{{.}}
{{- end}}
var _exc unsafe.Pointer
{{- if .HasNSError}}
var _nsErr unsafe.Pointer
{{- end}}
{{- if eq .RetKind 0}}
{{.RawCall}}
{{- else if eq .RetKind 5}}
_result := {{.ResultExpr}}
{{- else}}
_ptr := unsafe.Pointer({{.RawCall}})
{{- end}}
cgo.RaiseIfException(_exc)
{{- if .HasNSError}}
{{- if eq .RetKind 0}}
if _nsErr != nil {
return cgo.NSErrorToError(_nsErr)
}
return nil
{{- else if eq .RetKind 1}}
if _nsErr != nil {
return nil, cgo.NSErrorToError(_nsErr)
}
return cgo.WrapObject(_ptr), nil
{{- else if eq .RetKind 2}}
if _nsErr != nil {
return nil, cgo.NSErrorToError(_nsErr)
}
return cgo.WrapTyped(_ptr, {{.WrapTypedExpr}}), nil
{{- else if eq .RetKind 3}}
if _nsErr != nil {
if _ptr != nil {
cgo.FreePtr(_ptr)
}
return {{.RetType}}{}, cgo.NSErrorToError(_nsErr)
}
if _ptr == nil {
return {{.RetType}}{}, nil
}
_result := *(*{{.RetType}})(unsafe.Pointer(_ptr))
cgo.FreePtr(_ptr)
return _result, nil
{{- else}}
if _nsErr != nil {
return _result, cgo.NSErrorToError(_nsErr)
}
return _result, nil
{{- end}}
{{- else}}
{{- if eq .RetKind 1}}
return cgo.WrapObject(_ptr)
{{- else if eq .RetKind 2}}
return cgo.WrapTyped(_ptr, {{.WrapTypedExpr}})
{{- else if eq .RetKind 3}}
if _ptr == nil {
return {{.RetType}}{}
}
_result := *(*{{.RetType}})(unsafe.Pointer(_ptr))
cgo.FreePtr(_ptr)
return _result
{{- else if eq .RetKind 4}}
if _ptr == nil {
return nil
}
_s := C.GoString((*C.char)(_ptr))
return &_s
{{- else if eq .RetKind 5}}
return _result
{{- end}}
{{- end}}
{{end}}
