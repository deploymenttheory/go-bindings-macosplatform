{{/*
    interfaces.tmpl — templates for a complete _interfaces.go file.

    Named templates:
      interfaces_file   complete Go source file: package + imports + all interfaces
      interfaces_item   one interface definition + compile-time satisfaction check
*/}}

{{define "interfaces_file"}}// Code generated by go-bindings-codegen. DO NOT EDIT.

//go:build darwin

package {{.PkgName}}

import (
{{- range .Imports}}
	{{. | printf "%q"}}
{{- end}}
)
{{if or .UsesUnsafe .UsesObjc}}
{{if .UsesUnsafe}}var _ unsafe.Pointer // suppress unused import
{{end -}}{{if .UsesObjc}}var _ cgo.Object = nil // suppress unused import
{{end -}}
{{end}}
{{range .Interfaces}}{{template "interfaces_item" .}}{{end}}{{end}}

{{define "interfaces_item"}}// {{.GoName}}able is the Go interface for the Objective-C {{.GoName}} class.
// Implement it to mock {{.GoName}} in tests or accept any compatible type.
type {{.GoName}}able interface {
	{{.EmbedLine}}
{{- range .Methods}}
	{{.GoName}}({{.Params}}){{if .Ret}} {{.Ret}}{{end}}
{{- end}}
{{- if .HasNSCoding}}
	SerializeToArchive(ctx context.Context) ([]byte, error)
{{- end}}
}

var _ {{.GoName}}able = (*{{.GoName}})(nil)

{{end}}
