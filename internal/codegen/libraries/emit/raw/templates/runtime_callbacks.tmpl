{{/*
    method_trampolines.tmpl — templates for the runtime method IMP trampoline files.

    Named templates:
      method_trampolines_go_file    complete callbacks_generated.go
      method_trampoline_go_sig      one goCallIMP_* export function
      method_trampolines_h_file     complete method_trampolines_generated.h
      method_trampolines_m_file     complete method_trampolines_generated.m
      method_trampoline_c_imp       one goIMP_* C function implementation
*/}}


{{define "method_trampolines_go_file"}}// Code generated by go-bindings-codegen. DO NOT EDIT.

//go:build darwin

package {{.PkgName}}

// #include "callbacks_abi.h"
// #include "method_trampolines_generated.h"
import "C"
{{if .Sigs}}
import (
	"runtime/debug"
	"unsafe"

	"github.com/deploymenttheory/go-bindings-macosplatform/bindings/runtime/cgo"
)
{{end}}
{{range .Sigs}}{{template "method_trampoline_go_sig" .}}{{end}}{{end}}


{{define "method_trampoline_go_sig"}}//export goCallIMP_{{.Name}}
func goCallIMP_{{.Name}}({{.GoParams}}){{.RetDecl}} {
	defer func() {
		if r := recover(); r != nil {
			if h := cgo.OnCallbackPanic; h != nil {
				h("goCallIMP_{{.Name}}", r, debug.Stack())
			}
		}
	}()
	fn := callbackLookup(uint64(key))
	if fn == nil {
		return
	}
	{{.CallBody}}
}

{{end}}


